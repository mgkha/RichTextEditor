@page "/"
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Write a story</PageTitle>

<div class="medium-editor">
    <div class="medium-canvas">
        <input class="story-title"
               placeholder="Title"
               value="@_title"
               @oninput="OnTitleInput" />

        @* Spoiler and youtube are QuillBlazor's default modules, so there is
           nothing to configure here to get both toolbar buttons. *@
        <QuillEditor @ref="_editor"
                     Theme="bubble"
                     Class="rte-content"
                     Placeholder="Tell your story..."
                     InitialContent="@_initialContent"
                     OnChanged="HandleChanged" />
    </div>

    <div class="editor-bar">
        <span class="word-count">
            @_wordCount words
            @if (_saveStatus is not null)
            {
                <span class="save-status">· @_saveStatus</span>
            }
        </span>
        <div class="editor-actions">
            <button class="btn-ghost" @onclick="ClearDraftAsync">Clear</button>
            <button class="btn-ghost" @onclick="PreviewAsync">Preview</button>
            <button class="btn-publish" @onclick="PublishAsync">Publish</button>
        </div>
    </div>

    @if (_showPreview)
    {
        <div class="preview-overlay" @onclick="ClosePreview">
            <article class="preview-card" @onclick:stopPropagation="true">
                <button class="preview-close" @onclick="ClosePreview" aria-label="Close">&times;</button>
                <h1 class="preview-title">@(string.IsNullOrWhiteSpace(_title) ? "Untitled" : _title)</h1>
                @* ql-editor stays so Quill's own format classes (.ql-align-*,
                   .ql-indent-*, list counters) still resolve in the preview;
                   quill-spoiler-reveal opts the container into the spoiler
                   module's click-to-reveal (and its blur until then). *@
                <div class="preview-body rte-content ql-editor quill-spoiler-reveal">@((MarkupString)_html)</div>
            </article>
        </div>
    }
</div>

@code {
    private const string StorageKey = "rte-draft";
    private const int SaveDebounceMs = 800;

    private CancellationTokenSource? _saveDebounceCts;
    private QuillEditor? _editor;
    private string _title = "";
    private string _html = "";
    // The Delta the editor last reported. Kept alongside the HTML so saving a
    // draft needs no round-trip back into JS.
    private string? _delta;
    private int _wordCount;
    private bool _showPreview;
    private string? _initialContent;
    private string? _saveStatus;

    // Load any saved draft before the editor is created, so InitialContent
    // is ready when QuillEditor initializes.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrEmpty(json))
            {
                var draft = System.Text.Json.JsonSerializer.Deserialize<Draft>(json);
                if (draft is not null)
                {
                    _title = draft.Title ?? "";
                    _initialContent = draft.Delta;
                    _saveStatus = "Draft restored";
                }
            }
        }
        catch { /* corrupt/unavailable storage — start fresh */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.EnableSpoilerRevealAsync();
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        _title = e.Value?.ToString() ?? "";
        QueueSave();
    }

    // One notification per edit carries both forms of the document, so nothing
    // here has to ask the editor for anything. The first one arrives as soon as
    // the editor exists, which is what gives a restored draft its word count.
    private void HandleChanged(QuillChange change)
    {
        _html = change.Html;
        _delta = change.Delta;
        _wordCount = HtmlText.CountWords(_html);

        // Only a person typing is worth persisting: saving in response to our
        // own restore would just write the draft back over itself.
        if (change.FromUser) QueueSave();
    }

    // Restart the debounce clock on every edit; the actual save runs only
    // after SaveDebounceMs of no further changes.
    private void QueueSave()
    {
        _saveDebounceCts?.Cancel();
        _saveDebounceCts = new CancellationTokenSource();
        _saveStatus = "Saving…";
        _ = DebouncedSaveAsync(_saveDebounceCts.Token);
    }

    private async Task DebouncedSaveAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SaveDebounceMs, token);
            await SaveDraftAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* superseded by a newer edit */ }
    }

    // Persist title + Delta (the canonical, re-editable form) to localStorage.
    private async Task SaveDraftAsync()
    {
        var draft = new Draft { Title = _title, Delta = _delta ?? _initialContent };
        var json = System.Text.Json.JsonSerializer.Serialize(draft);
        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
        _saveStatus = "Saved";
    }

    public void Dispose() => _saveDebounceCts?.Cancel();

    private async Task ClearDraftAsync()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        _title = "";
        _html = "";
        _delta = null;
        _wordCount = 0;
        _saveStatus = "Cleared";
        if (_editor is not null)
            await _editor.SetContentsAsync(null);
    }

    // Read straight from the editor rather than trusting the debounced copy,
    // so a preview or publish that lands mid-keystroke is still current.
    private async Task PreviewAsync()
    {
        if (_editor is not null)
            _html = await _editor.GetHtmlAsync() ?? "";
        _showPreview = true;
    }

    private void ClosePreview() => _showPreview = false;

    private async Task PublishAsync()
    {
        if (_editor is not null)
        {
            _delta = await _editor.GetContentsAsync();
            _html = await _editor.GetHtmlAsync() ?? "";
        }

        // TODO: POST { _title, _delta, _html } to your API.
        Console.WriteLine($"Publishing '{_title}' ({_wordCount} words)");
        Console.WriteLine(_delta);

        _showPreview = true;
    }

    private sealed class Draft
    {
        public string? Title { get; set; }
        public string? Delta { get; set; }
    }
}
