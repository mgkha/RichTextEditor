@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_editorElement" class="quill-host rte-content"></div>

@code {
    private ElementReference _editorElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QuillEditor>? _selfRef;
    private bool _initialized;

    /// <summary>Quill theme: "bubble" (Medium-style floating toolbar) or "snow" (fixed toolbar).</summary>
    [Parameter] public string Theme { get; set; } = "bubble";

    [Parameter] public string Placeholder { get; set; } = "Tell your story...";

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Initial content as a Delta JSON string. Applied once, after the editor is created.</summary>
    [Parameter] public string? InitialContent { get; set; }

    /// <summary>Raised on every edit, carrying the current semantic HTML.</summary>
    [Parameter] public EventCallback<string> OnHtmlChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/quillEditor.js");
        _selfRef = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("create", _editorElement, _selfRef, new
        {
            theme = Theme,
            placeholder = Placeholder,
            readOnly = ReadOnly
        });

        if (!string.IsNullOrEmpty(InitialContent))
            await _module.InvokeVoidAsync("setContents", _editorElement, InitialContent);

        await _module.InvokeVoidAsync("enableSpoilerReveal");

        _initialized = true;
    }

    [JSInvokable]
    public async Task OnTextChanged(string source)
    {
        if (OnHtmlChanged.HasDelegate)
            await OnHtmlChanged.InvokeAsync(await GetHtmlAsync());
    }

    [JSInvokable]
    public Task OnSelectionChanged(bool hasSelection) => Task.CompletedTask;

    // ---- Public API for parent components ----

    public ValueTask<string?> GetContentsAsync()
        => _module is null ? ValueTask.FromResult<string?>(null)
                           : _module.InvokeAsync<string?>("getContents", _editorElement);

    public ValueTask<string?> GetHtmlAsync()
        => _module is null ? ValueTask.FromResult<string?>(null)
                           : _module.InvokeAsync<string?>("getHtml", _editorElement);

    public ValueTask<string?> GetTextAsync()
        => _module is null ? ValueTask.FromResult<string?>(null)
                           : _module.InvokeAsync<string?>("getText", _editorElement);

    public ValueTask<int> GetLengthAsync()
        => _module is null ? ValueTask.FromResult(0)
                           : _module.InvokeAsync<int>("getLength", _editorElement);

    public async Task SetContentsAsync(string? deltaJson)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("setContents", _editorElement, deltaJson);
    }

    public async Task SetHtmlAsync(string html)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("setHtml", _editorElement, html);
    }

    public async Task FocusAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("focus", _editorElement);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (_initialized)
                    await _module.InvokeVoidAsync("destroy", _editorElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit gone; nothing to clean up */ }
        }
        _selfRef?.Dispose();
    }
}
