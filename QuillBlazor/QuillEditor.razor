@namespace QuillBlazor
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_host" class="quill-blazor @Class"></div>

@code {
    // Static web asset path. Blazor resolves it against the app's <base href>,
    // so this works whether the app is served from / or a sub-path.
    private const string ModulePath = "./_content/QuillBlazor/quill-blazor.js";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QuillEditor>? _selfRef;

    /// <summary>Quill theme: <c>bubble</c> (toolbar on selection) or <c>snow</c> (fixed toolbar).</summary>
    [Parameter] public string Theme { get; set; } = "bubble";

    [Parameter] public string Placeholder { get; set; } = "";

    /// <summary>Initial content as a Delta JSON string. Applied once, when the editor is created.</summary>
    [Parameter] public string? InitialContent { get; set; }

    /// <summary>Raised after each edit, and once when the editor is first created.</summary>
    [Parameter] public EventCallback<QuillChange> OnChanged { get; set; }

    /// <summary>Extra CSS classes for the host element.</summary>
    [Parameter] public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _selfRef = DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync("create", _host, _selfRef, new
        {
            theme = Theme,
            placeholder = Placeholder,
            initialDelta = InitialContent
        });

        // Assigned only now, so the methods below cannot reach a half-built
        // editor: a null _module means "not ready yet".
        _module = module;
    }

    [JSInvokable]
    public Task OnQuillChanged(QuillChange change)
        => OnChanged.HasDelegate ? OnChanged.InvokeAsync(change) : Task.CompletedTask;

    /// <summary>The document as a Delta JSON string — the form to persist.</summary>
    public async ValueTask<string?> GetContentsAsync()
        => _module is null ? null : await _module.InvokeAsync<string?>("getContents", _host);

    public async ValueTask<string?> GetHtmlAsync()
        => _module is null ? null : await _module.InvokeAsync<string?>("getHtml", _host);

    /// <summary>Replace the document from a Delta JSON string; null clears it.</summary>
    public async ValueTask SetContentsAsync(string? deltaJson)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("setContents", _host, deltaJson);
    }

    public async ValueTask FocusAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("focus", _host);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit gone; nothing to clean up */ }
        }
        _selfRef?.Dispose();
    }
}
